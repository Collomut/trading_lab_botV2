# ============================================================
# trade_v2 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Exchange ---
EXCHANGE=binance
# Paper trade by default. Live trading is blocked unless BOTH
# ALLOW_LIVE_TRADING=true AND LIVE_CONFIRMATION=<matching operator phrase>
# are set AND the LIVE_READINESS checklist is acknowledged.
PAPER_TRADING=true
PAPER_ENVIRONMENT=testnet          # testnet | demo | simulated
ALLOW_LIVE_TRADING=false
LIVE_CONFIRMATION=
API_KEY=
API_SECRET=
DEMO_API_KEY=
DEMO_API_SECRET=
FALLBACK_TO_SIMULATION=false

# --- Model ---
MODEL_TYPE=sklearn                 # sklearn | xgboost | lightgbm
MODEL_PATH=models/artifacts/model.joblib
FEATURE_VERSION=1
CONFIDENCE_THRESHOLD=0.60
MIN_EXPECTED_RETURN_PCT=1.5
CALIBRATION_METHOD=platt           # platt | isotonic | none
MODEL_REFRESH_HOURS=168
# Horizon (in bars) the model predicts over.
MODEL_HORIZON_BARS=4

# --- Risk ---
MAX_RISK_PER_TRADE=1.0             # % of equity at risk per trade
MAX_NOTIONAL_PCT=10.0              # % of equity max notional per position
STOP_LOSS_ATR_MULTIPLE=1.5
STOP_LOSS_MIN_PCT=1.5
STOP_LOSS_MAX_PCT=4.0
BREAK_EVEN_TRIGGER_R=1.5
TRAILING_STOP_ATR_MULTIPLE=3.0
TIME_STOP_BARS=48
MAX_DAILY_LOSS_PCT=3.0
MAX_ROLLING_DRAWDOWN_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
ROLLING_PF_WINDOW=20
MIN_ROLLING_PF=1.0
MAX_SPREAD_BPS=20
MAX_SLIPPAGE_BPS=30
MAX_PAIRWISE_CORRELATION=0.85
MAX_SIGNAL_FILL_DIVERGENCE_BPS=100
MAX_TESTNET_PRICE_DIVERGENCE_PCT=0.5

# --- Universe ---
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
LOOKBACK_CANDLES=1000
MIN_VOLUME_USDT=10000000

# --- Execution ---
POST_ONLY_ENTRIES=false
ORDER_TIMEOUT_SECONDS=30
MAX_REQUOTES=5
FEE_RATE=0.001                     # taker fee per side (0.1%)
SLIPPAGE_BPS=5                     # base slippage assumption for backtests

# --- Dashboard ---
DASHBOARD_TOKEN=
DASHBOARD_PORT=5000

# --- Notifications ---
ENABLE_NOTIFICATIONS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
DISCORD_WEBHOOK_URL=

# --- State ---
DATABASE_URL=
DATA_DIR=data
INITIAL_BALANCE=10000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
